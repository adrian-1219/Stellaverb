import numpy as np
from scipy.io import wavfile
from astropy.table import Table

def build_stereo_ir_from_gaia(
    tbl,
    sr=44100,
    max_delay_s=3.0,
    ra_col="ra",
    dec_col="dec",               # optional; can be used to subtly narrow/widen
    distance_col="distance_pc",  # if missing, computed from parallax
    parallax_col="parallax",
    mag_col="phot_g_mean_mag",
    mag_ref_percentile=1.0,      # reference magnitude near bright end
    clip_gain_percentile=99.9,   # keep a few bright stars from dominating
    use_dec_width=True           # if True, use dec to narrow/widen stereo slightly
):
    """
    Returns stereo impulse response: float32 array (num_samples, 2) [L, R]
    """
    # --- distances (pc) ---
    if distance_col in tbl.colnames:
        d = np.array(tbl[distance_col])
    else:
        p = np.array(tbl[parallax_col])
        d = 1000.0 / p

    ra = np.array(tbl[ra_col])
    dec = np.array(tbl[dec_col]) if dec_col in tbl.colnames else None
    G = np.array(tbl[mag_col])

    # Fill masked -> NaN (works whether masked or not)
    d  = np.array(np.ma.filled(d, np.nan), dtype=np.float64)
    ra = np.array(np.ma.filled(ra, np.nan), dtype=np.float64)
    G  = np.array(np.ma.filled(G, np.nan), dtype=np.float64)
    if dec is not None:
        dec = np.array(np.ma.filled(dec, np.nan), dtype=np.float64)

    # --- filter invalid ---
    good = np.isfinite(d) & np.isfinite(ra) & np.isfinite(G) & (d > 0)
    if dec is not None:
        good = good & np.isfinite(dec)

    d, ra, G = d[good], ra[good], G[good]
    if dec is not None:
        dec = dec[good]

    if len(d) == 0:
        raise ValueError("No valid rows after filtering (need finite distance, ra, G).")

    # --- distance -> delay ---
    n_samples = int(max_delay_s * sr) + 1
    dmin, dmax = np.min(d), np.max(d)
    if dmax == dmin:
        delays = np.zeros_like(d, dtype=np.int64)
    else:
        delays = np.floor(((d - dmin) / (dmax - dmin)) * (max_delay_s * sr)).astype(np.int64)
        delays = np.clip(delays, 0, n_samples - 1)

    # --- brightness (G mag) -> gain (flux-like) ---
    # gain ~ 10^(-0.4*(G - G_ref))
    G_ref = np.percentile(G, mag_ref_percentile)
    gains = 10.0 ** (-0.4 * (G - G_ref))

    # robust clip/normalize
    g_clip = np.percentile(gains, clip_gain_percentile)
    if not np.isfinite(g_clip) or g_clip <= 0:
        g_clip = np.max(gains)
    gains = np.clip(gains / (g_clip + 1e-12), 0.0, 1.0)

    # --- direction -> stereo pan ---
    # Map RA (deg 0..360) to pan position x in [-1, 1]
    # x=-1 hard left, x=+1 hard right
    az = np.deg2rad(ra)
    x = np.cos(az)  # smooth mapping around the circle into L/R

    # Optional: use Dec to narrow width near poles (subtle)
    if use_dec_width and dec is not None:
        el = np.deg2rad(dec)
        width = np.cos(el)  # near +/-90°, width shrinks
        x = x * width

    # Equal-power panning
    pan = (x + 1.0) * 0.5                  # 0..1
    Lg = np.sqrt(1.0 - pan)                 # left gain
    Rg = np.sqrt(pan)                       # right gain

    # --- accumulate impulses ---
    ir = np.zeros((n_samples, 2), dtype=np.float32)
    for i in range(len(gains)):
        idx = int(delays[i])
        g = gains[i]
        ir[idx, 0] += g * Lg[i]
        ir[idx, 1] += g * Rg[i]

    # --- sanitize + normalize ---
    ir = np.nan_to_num(ir, nan=0.0, posinf=0.0, neginf=0.0)
    peak = np.max(np.abs(ir))
    if peak > 0:
        ir = ir / peak

    return ir

# Example usage:
# ir = build_stereo_ir_from_gaia(results, sr=44100, max_delay_s=3.0)
# wavfile.write("gaia_ir_stereo.wav", 44100, np.int16(np.round(ir * 32767)))

tbl = Table.read("gaia_subset_parallax_7.fits")
tbl['distance_pc'] = 1000.0 / tbl['parallax']

ir = build_stereo_ir_from_gaia(tbl, sr=44100, max_delay_s=3.0)
print(ir.tolist())
wavfile.write("gaia_ir_stereo.wav", 44100, np.int16(np.round(ir * 32767)))